          "expr": "avg(k6_http_req_tls_handshaking_p95{testid=~\"$testid\"})",
          "legendFormat": "tls_handshaking"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 35 },
      "id": 400,
