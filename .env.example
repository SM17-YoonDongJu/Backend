# Database
DB_NAME=soma_db
DB_USER=soma
DB_PASSWORD=your_db_password

# JWT
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long

# AWS S3
S3_BUCKET=your-s3-bucket-name
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY=your_aws_access_key
AWS_SECRET_KEY=your_aws_secret_key

# OAuth2
KAKAO_CLIENT_ID=your_kakao_client_id
KAKAO_CLIENT_SECRET=your_kakao_client_secret
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# FCM (오프라인 채팅 푸시 알림 — 미설정 시 stub 모드로 동작)
FCM_SERVICE_ACCOUNT_PATH=/path/to/firebase-service-account.json

# Kafka (OCR 트리거 producer — MSK bootstrap servers, 미설정 시 localhost:9092)
KAFKA_BOOTSTRAP_SERVERS=b-1.somamsk.qxa8lc.c3.kafka.ap-northeast-2.amazonaws.com:9092,b-2.somamsk.qxa8lc.c3.kafka.ap-northeast-2.amazonaws.com:9092
# 통신 보안 프로토콜 (dev: PLAINTEXT / 운영: SASL_SSL·SSL 등으로 오버라이드)
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
