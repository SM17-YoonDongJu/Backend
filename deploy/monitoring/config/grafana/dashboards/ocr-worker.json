        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (pod) (container_memory_working_set_bytes{cluster=\"soma-k8s\", namespace=\"default\", container=\"ocr-worker\"})",
          "legendFormat": "{{pod}}"
