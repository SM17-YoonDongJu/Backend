{
  "permissions": {
    "allow": [
      "Write(.claude/agents/*)",
      "Edit(.claude/agents/*)",
      "Write(.claude/skills/*)",
      "Edit(.claude/skills/*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "type": "command",
        "command": "cd \"C:/work/backend\" && ./gradlew checkstyleMain -q 2>&1 | tail -5",
        "shell": "bash",
        "timeout": 60,
        "statusMessage": "Checkstyle 검사 중..."
      }
    ]
  }
}
