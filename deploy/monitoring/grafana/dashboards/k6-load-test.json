          "expr": "k6_http_req_duration_p99{testid=~\"$testid\", name=~\"$name\"}",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "id": 300,
      "panels": [],
      "title": "TTFB · 연결 단계 지표",
      "type": "row"
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "http_req_waiting p95 (TTFB 근사치)",
      "description": "서버가 응답을 시작하기까지 걸린 시간 — 백엔드 처리 지연 확인용. api-latency-percentiles.json의 서버 사이드 p95와 같이 보면 네트워크 구간(전송)과 서버 처리 구간을 구분할 수 있다.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 27 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "k6_http_req_waiting_p95{testid=~\"$testid\", name=~\"$name\"}",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "연결 단계 지표 p95 (blocked / connecting / TLS)",
      "description": "이 값들이 튀면 앱 로직보다 네트워크·연결 문제일 가능성이 크다. blocked=요청 전 커넥션 슬롯 대기, connecting=TCP 연결, tls_handshaking=TLS 핸드셰이크(HTTP인 경우 0).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 27 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "avg(k6_http_req_blocked_p95{testid=~\"$testid\"})",
          "legendFormat": "blocked"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "avg(k6_http_req_connecting_p95{testid=~\"$testid\"})",
