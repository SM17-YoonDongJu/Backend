  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["brbs", "rds", "cloudwatch"],
  "templating": {
    "list": [
      {
        "name": "region",
        "type": "custom",
        "query": "ap-northeast-2",
        "current": { "text": "ap-northeast-2", "value": "ap-northeast-2" },
        "options": [{ "text": "ap-northeast-2", "value": "ap-northeast-2", "selected": true }]
      },
      {
        "name": "dbinstance",
        "type": "query",
        "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
        "query": "dimension_values($region,AWS/RDS,CPUUtilization,DBInstanceIdentifier)",
        "refresh": 1,
        "includeAll": false,
        "multi": false
      }
    ]
  },
