# dev EC2 배포용 환경변수 예시. 실제 값은 서버의 .env.dev(시크릿)에 두고 커밋하지 않는다.
# 이 파일은 "필요한 키 목록" 문서 역할이다. (backend + report + chatbot 공용)

# ECR
ECR_REGISTRY=
BACKEND_TAG=dev
REPORT_TAG=dev
CHATBOT_TAG=dev

# 공통 (backend는 ENV, report/chatbot은 ENVIRONMENT 사용)
ENV=dev
ENVIRONMENT=dev
LOG_LEVEL=INFO
AWS_REGION=ap-northeast-2
# 관측성 식별자(선택, 비우면 hostname)
INSTANCE_ID=

# RDS (Backend)
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# RDS (report/chatbot — RAG 검색·저장)
DATABASE_URL=
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
# prod TLS 시에만
RDS_CA_PATH=

# Redis (컨테이너: REDIS_HOST=redis) — chatbot 필수
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# SQS (OCR 트리거) — 관리형 AWS SQS. 자격증명은 인스턴스 IAM Role 위임(AWS_REGION 위 참조).
# backend는 큐 이름(ocr-job-queue)에서 URL을 런타임 해석하므로 별도 env 불필요.
# report 워커가 소비하는 OCR 트리거 큐 URL. ⚠️ 변수명·튜닝값은 AI 워커 SQS 소비자 구현과 합의 후 확정.
SQS_OCR_JOB_QUEUE_URL=

# JWT
JWT_SECRET=

# PII 컬럼 암호화(user_claims·user_insurances, AES-256-GCM). dev도 fallback 없이 여기서 반드시 주입한다.
# 생성: `openssl rand -base64 32`. Apple 토큰 키와 다른 값을 쓴다(용도별 키 분리). 커밋 금지.
PII_ENC_KEY=

# S3 (자격증명은 IAM Role 자동 탐색 — 키 불필요)
S3_BUCKET=

# OAuth Kakao
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# OAuth Naver
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 로그인 동작(쿠키 인증) — 프론트↔백 배포 토폴로지에 맞춰 설정
# OAUTH_BASE_URL: 토큰 교환 시 provider로 보내는 redirect_uri({baseUrl}/login/oauth2/code/{provider})의
#   {baseUrl}. 프론트가 인가요청에 쓴 redirect_uri·provider 콘솔 등록값과 정확히 일치해야 한다.
OAUTH_BASE_URL=http://localhost:8080
# OAUTH_ALLOWED_REDIRECT_ORIGINS: 프론트가 콜백에 넘긴 redirect_uri를 허용할 오리진 목록(쉼표 구분).
#   리버스 프록시(:8080)·프론트 직접(:3000)·운영 도메인 등 프론트가 쓰는 오리진을 모두 등록.
OAUTH_ALLOWED_REDIRECT_ORIGINS=http://localhost:8080,http://localhost:3000,https://brbosang.com
# CORS_ALLOWED_ORIGIN_PATTERNS: 쿠키 인증이라 와일드카드(*) 불가 → 프론트 오리진 패턴 목록(쉼표 구분)
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:3000
# 쿠키 SameSite/Secure — 프론트·백이 다른 사이트(cross-site)이고 백엔드가 HTTPS면 None+true 필수.
#   백엔드가 평문 http면 Secure 쿠키를 브라우저가 거부하므로 cross-site 쿠키 로그인은 불가(HTTPS 필요).
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# 관측성 (Prometheus + Grafana + Loki + Tempo, #88) — 별도 모니터링 인스턴스(brbs-monitoring, #214)에서
# docker-compose.monitoring.yml로 기동. 외부 미노출(127.0.0.1) + SSM 포워드 접근. 이 .env.dev를 앱/모니터링
# 두 인스턴스 모두에 배치한다(공용 파일 — 인스턴스별로 쓰는 값만 다르고 나머지는 무시됨).
# Grafana 초기 관리자 계정(접속 후 비밀번호 변경 권장). GRAFANA_ADMIN_PASSWORD 미설정 시 compose 기동 실패.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# Grafana 루트 URL — SSM 포워드로 접근하면 localhost, 리버스 프록시 뒤면 실제 외부 URL
GRAFANA_ROOT_URL=http://localhost:3000
# 모니터링 알림 Discord 웹훅(시크릿) — severity 라우팅: critical→#alert-critical, warning→#alert-warning.
# 채널마다 웹훅 1개씩 생성해 넣는다. 미설정 시 grafana 기동 실패(의도된 가드)
ALERT_WEBHOOK_URL_CRITICAL=
ALERT_WEBHOOK_URL_WARNING=
# 분산 트레이싱 push 대상(backend → Tempo, #214로 모니터링 인스턴스 분리) — 형식:
# http://<모니터링 인스턴스 private IP>:4318/v1/traces (앱 인스턴스의 .env.dev에만 필요)
OTLP_TRACING_ENDPOINT=

# AI - LLM (GPU EC2 ollama, OpenAI 호환)
AI_SERVICE_URL=
AI_BASE_URL=
AI_API_KEY=not-needed
AI_TIMEOUT_SECONDS=60
LLM_MODEL=gemma3:12b

# AI - Embedding
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# 가드레일 NER (USE_NER=true일 때만 NER_* 필요)
USE_NER=false
NER_MODEL=
NER_SCORE_THRESHOLD=

# Backend URL (AI → backend 콜백)
BACKEND_URL=
