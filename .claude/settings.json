{
  "permissions": {
    "allow": [
      "Write(.claude/agents/*)",
      "Edit(.claude/agents/*)",
      "Write(.claude/skills/*)",
      "Edit(.claude/skills/*)",
      "Write(_workspace/**)",
      "Edit(_workspace/**)",
      "Write(src/**)",
      "Edit(src/**)",
      "Write(build.gradle)",
      "Edit(build.gradle)",
      "Write(settings.gradle)",
      "Edit(settings.gradle)",
      "Bash(./gradlew compileJava)",
      "Bash(./gradlew test)",
      "Bash(git status:*)",
      "Bash(git diff:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/guard-git.js", "timeout": 10 }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/guard-paths.js", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/warn-native-query.js", "timeout": 10 }
        ]
      }
    ]
  }
}
