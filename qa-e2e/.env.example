# 백엔드 API base URL (필수) — 프론트(vercel)가 호출하는 서버 주소.
#   로컬 백엔드:  http://localhost:8080
#   원격 dev:     https://<백엔드-도메인>
API_BASE_URL=http://localhost:8080

# CORS 허용 오리진 테스트용 (선택, 기본 vercel 프론트)
ALLOWED_ORIGIN=https://frontend-web-psi-two.vercel.app

# dev-login 닉네임 (선택) — app.dev-login.enabled=true 인 로컬 백엔드에서만 동작.
DEV_LOGIN_NICKNAME=qa-user
