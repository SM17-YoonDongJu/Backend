# dev EC2 배포용 환경변수 예시. 실제 값은 서버의 .env.dev(시크릿)에 두고 커밋하지 않는다.
# 이 파일은 "필요한 키 목록" 문서 역할이다. (backend + report + chatbot 공용)

# ECR
ECR_REGISTRY=
BACKEND_TAG=dev
REPORT_TAG=dev
CHATBOT_TAG=dev

# 공통 (backend는 ENV, report/chatbot은 ENVIRONMENT 사용)
ENV=dev
ENVIRONMENT=dev
LOG_LEVEL=INFO
AWS_REGION=ap-northeast-2
# 관측성 식별자(선택, 비우면 hostname)
INSTANCE_ID=

# RDS (Backend)
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# RDS (report/chatbot — RAG 검색·저장)
DATABASE_URL=
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
# prod TLS 시에만
RDS_CA_PATH=

# Redis (컨테이너: REDIS_HOST=redis) — chatbot 필수
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Kafka (컨테이너: kafka:9092)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# backend가 발행하는 OCR 트리거 토픽
KAFKA_OCR_JOB_TOPIC=
# report 워커가 소비하는 토픽
KAFKA_REPORT_JOB_TOPIC=
KAFKA_CONSUMER_GROUP=
KAFKA_DLQ_SUFFIX=.dlq
KAFKA_MAX_RETRIES=3

# JWT
JWT_SECRET=

# S3 (자격증명은 IAM Role 자동 탐색 — 키 불필요)
S3_BUCKET=

# OAuth Kakao
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# OAuth Naver
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# AI - LLM (GPU EC2 ollama, OpenAI 호환)
AI_SERVICE_URL=
AI_BASE_URL=
AI_API_KEY=not-needed
AI_TIMEOUT_SECONDS=60
LLM_MODEL=gemma3:12b

# AI - Embedding
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# 가드레일 NER (USE_NER=true일 때만 NER_* 필요)
USE_NER=false
NER_MODEL=
NER_SCORE_THRESHOLD=

# Backend URL (AI → backend 콜백)
BACKEND_URL=
