# Database
DB_NAME=soma_db
DB_USER=soma
DB_PASSWORD=your_db_password
# DB 커넥션 풀 (HikariCP) — 미설정 시 max=10 / min-idle=2
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# JVM 옵션 오버라이드 (미설정 시 Dockerfile 기본값: MaxRAMPercentage=75, G1GC, GC 로그, OOM 힙덤프)
# JAVA_OPTS=-XX:MaxRAMPercentage=70.0 -XX:+UseG1GC

# 로그 파일/GC 로그/힙덤프 저장 디렉터리 (기본 /app/logs). dev·prod 프로파일에서 app.log 기록 →
# /actuator/logfile 엔드포인트가 이 경로를 읽는다. logback-spring.xml FILE appender와 공유.
# LOG_DIR=/app/logs
# LOG_LEVEL=INFO

# 분산 트레이싱 (Micrometer Tracing → OTLP → Tempo)
# 기본 OFF. Tempo가 있는 환경에서만 켠다(dev compose가 자동 주입). local·test는 프로파일에서 강제 OFF.
# TRACING_ENABLED=true
# OTLP_TRACING_ENDPOINT=http://tempo:4318/v1/traces
# 샘플링 확률: dev 기본 1.0(전량), prod 기본 0.1(10%). 재배포 없이 이 값만 바꿔 조정.
# TRACING_SAMPLE_PROBABILITY=1.0

# 참고: dev·prod 프로파일은 로그를 구조화 JSON(logstash)으로 출력한다(logging.structured.format).
# Alloy가 컨테이너 stdout을 수집해 Loki로 보내고, Grafana에서 traceId로 로그↔트레이스↔메트릭을 상호 연결한다.
# 관측성 스택 시크릿(GRAFANA_ADMIN_PASSWORD·ALERT_WEBHOOK_URL_*)은 배포용 .env.dev에서 관리한다.

# JWT
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long

# AWS S3
# 자격증명은 IAM Role(EC2/ECS) 또는 ~/.aws/credentials 로 자동 탐색한다 (정적 키 직접 주입 안 함)
S3_BUCKET=your-s3-bucket-name
AWS_REGION=ap-northeast-2

# OAuth2
KAKAO_CLIENT_ID=your_kakao_client_id
KAKAO_CLIENT_SECRET=your_kakao_client_secret
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret
# Apple (Web / Services ID) — 미설정 시 앱은 기동되나 apple 로그인만 비활성
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_CLIENT_ID=com.example.web   # Services ID
# .p8 파일을 base64로 인코딩: `base64 -i AuthKey_XXXX.p8` (Linux: base64 -w0). 원본 PEM·base64 본문도 허용
APPLE_PRIVATE_KEY=base64_of_p8_file
# Apple refresh_token 저장용 AES-256-GCM 키 (base64 인코딩된 32바이트). 미설정 시 로컬 dev 기본값 사용.
# 운영은 반드시 고유 키로 교체: `openssl rand -base64 32`. 절대 커밋/로깅하지 않는다.
APPLE_TOKEN_ENC_KEY=base64_encoded_32_byte_key

# PII 컬럼 암호화 (user_claims·user_insurances·reports의 자유서술/카탈로그성 컬럼, AES-256-GCM)
# 로컬/개발/테스트: 아래 raw 키를 그대로 쓰거나 미설정(application.yml dev 기본값 사용).
# 생성: `openssl rand -base64 32`. Apple 토큰 키와 반드시 다른 값을 쓴다(용도별 키 분리). 커밋·로깅 금지.
PII_ENC_KEY=base64_encoded_32_byte_key

# phone_number·provider_user_id HMAC-SHA256 블라인드 인덱스용 DEK(이슈 #232). 조회 조건(WHERE 동등비교)으로
# 쓰이는 PII 컬럼은 AES-GCM만으로 조회가 안 돼 별도 결정적 다이제스트 키가 필요하다.
# 로컬/개발/테스트: 아래 raw 키를 그대로 쓰거나 미설정(application.yml dev 기본값 사용).
# 생성: `openssl rand -base64 32`. PII_ENC_KEY와 반드시 다른 값을 쓴다(용도별 키 분리). 커밋·로깅 금지.
PII_HMAC_KEY=base64_encoded_32_byte_key

# 운영 전용: PII 전용 KMS CMK (키 ID 또는 ARN). 값이 있으면 KMS 봉투암호화 경로로 전환되고
# 앱이 kms:GenerateDataKey/kms:Decrypt를 호출한다(자격증명은 IAM Role 자동 탐색).
# 로컬·CI에서는 반드시 비워 둔다. 운영에서는 필수 — 미설정 시 앱이 기동되지 않는다.
# RDS 기본 볼륨 암호화 키·APPLE_TOKEN_ENC_KEY 재사용 금지.
# PII_KMS_KEY_ID=arn:aws:kms:ap-northeast-2:000000000000:key/00000000-0000-0000-0000-000000000000

# 쿠키 인증 / CORS (모두 기본값 있어 로컬에선 미설정 가능)
# COOKIE_SECURE: 운영 https 기본 true. 로컬 http 개발은 false
COOKIE_SECURE=true
# COOKIE_SAME_SITE: 기본 Lax. 프론트(Vercel)와 백엔드가 cross-site면 None(+COOKIE_SECURE=true, https 필수)
COOKIE_SAME_SITE=Lax
# CORS_ALLOWED_ORIGIN_PATTERNS: 쿠키 인증이라 와일드카드(*) 불가 → 쉼표 구분 패턴 목록
# 예: https://앱운영도메인,https://*.vercel.app
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:3000,https://frontend-web-psi-two.vercel.app,https://brbosang.com
# OAUTH_ALLOWED_REDIRECT_ORIGINS: 프론트가 넘긴 redirect_uri를 토큰 교환에 허용할 오리진 목록 (쉼표 구분)
# Apple/kakao/naver 공통 — 프론트가 Apple 리다이렉트를 받는 오리진과 반드시 일치(운영 brbosang.com + Vercel)
OAUTH_ALLOWED_REDIRECT_ORIGINS=http://localhost:8080,http://localhost:3000,https://frontend-web-psi-two.vercel.app,https://brbosang.com

# FCM (오프라인 채팅 푸시 알림 — 미설정 시 stub 모드로 동작)
FCM_SERVICE_ACCOUNT_PATH=/path/to/firebase-service-account.json

# SQS (OCR 트리거 producer)
# 자격증명·리전은 위 AWS 블록을 재사용(IAM Role/~/.aws 자동 탐색, 정적 키 미주입).
# 발행 대상 큐 이름 — 이 값이 아웃박스 topic 컬럼에 저장되고, 큐 URL은 런타임에 GetQueueUrl로 해석한다.
# 폴백 기본값이 없어 미설정 시 앱이 기동하지 않는다(잘못된 큐 이름이 아웃박스 행에 박제되는 사고 방지).
# local 프로파일로 띄우면 application-local.yml이 ocr-job-queue를 명시하므로 이 값 없이도 동작한다.
SQS_OCR_QUEUE_NAME=ocr-job-queue
# 로컬은 LocalStack로 접속 — 호스트 bootRun은 localhost:4566, app 컨테이너는 compose가 localstack:4566으로 오버라이드.
# dev/prod는 이 값을 비워(미설정) 실제 AWS SQS로 접속한다(IAM Role).
AWS_SQS_ENDPOINT=http://localhost:4566
