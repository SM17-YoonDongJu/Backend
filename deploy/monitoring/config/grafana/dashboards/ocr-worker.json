        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(max by (pod) (container_memory_working_set_bytes{cluster=\"soma-k8s\", namespace=\"default\", container=\"ocr-worker\"}) / max by (pod) (kube_pod_container_resource_limits{cluster=\"soma-k8s\", namespace=\"default\", container=\"ocr-worker\", resource=\"memory\"}))",
          "instant": true,
          "range": false
        }
      ]
