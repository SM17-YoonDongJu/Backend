<?xml version="1.0" encoding="UTF-8"?>
<!--
  PII 로깅 정책 (docs/logging-pii-policy.md 참조):
  - 요청/응답 본문(body), 헤더(Authorization), SQL 바인드 파라미터를 로그로 남기지 않는다.
  - 주민등록번호·연락처·의료정보(진단서)·결제정보·토큰은 절대 평문 로깅 금지.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <property name="LOG_DIR" value="${LOG_DIR:-/app/logs}"/>
    <!-- 본문/파라미터를 포함하지 않는 표준 패턴 -->
    <property name="APP_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${APP_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- 파일 로그는 배포 프로파일(dev·prod)에서만 활성화한다.
         로컬(local)·테스트는 /app/logs가 없어 appender 초기화 실패로 컨텍스트 기동이 깨진다(#91). -->
    <springProfile name="dev | prod">
        <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_DIR}/app.log</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_DIR}/app.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
                <maxFileSize>10MB</maxFileSize>
                <maxHistory>14</maxHistory>
                <totalSizeCap>500MB</totalSizeCap>
            </rollingPolicy>
            <encoder>
                <pattern>${APP_PATTERN}</pattern>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="FILE"/>
        </root>
    </springProfile>

    <!-- PII 유출 위험 로거 강제 억제 (application.yml 설정과 이중 안전장치) -->
    <logger name="org.hibernate.SQL" level="WARN"/>
    <logger name="org.hibernate.orm.jdbc.bind" level="WARN"/>
    <logger name="org.hibernate.type.descriptor.sql" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
