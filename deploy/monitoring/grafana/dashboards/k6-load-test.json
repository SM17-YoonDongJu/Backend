      "type": "row"
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "iteration_duration p95 (시나리오별)",
      "description": "VU 한 명이 시나리오 한 바퀴(여러 API를 묶은 사용자 흐름)를 도는 데 걸린 전체 시간.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "k6_iteration_duration_p95{testid=~\"$testid\"}",
          "legendFormat": "{{scenario}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Dropped Iterations Rate",
      "description": "constant-arrival-rate 실행기를 쓸 때 중요 — k6가 목표 RPS 자체를 못 만들어낸 횟수. shared-iterations/per-vu 실행기에서는 항상 No data(정상).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 36 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
