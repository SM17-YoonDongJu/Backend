# dev EC2 배포용 환경변수 예시. 실제 값은 서버의 .env.dev(시크릿)에 두고 커밋하지 않는다.
# 이 파일은 "필요한 키 목록" 문서 역할이다. (backend + ai 공용)

# ECR
ECR_REGISTRY=
BACKEND_TAG=dev
AI_TAG=dev

# 공통
ENV=dev
LOG_LEVEL=INFO
AWS_REGION=ap-northeast-2

# RDS (Backend)
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# RDS (AI)
DATABASE_URL=

# Redis (컨테이너: REDIS_HOST=redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Kafka (컨테이너: kafka:9092)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_OCR_JOB_TOPIC=
KAFKA_REPORT_JOB_TOPIC=

# JWT
JWT_SECRET=

# S3 (자격증명은 IAM Role 자동 탐색 — 키 불필요)
S3_BUCKET=

# OAuth Kakao
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# OAuth Naver
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# AI - LLM
AI_SERVICE_URL=
AI_BASE_URL=
AI_API_KEY=
LLM_MODEL=

# AI - Embedding
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_DIM=

# Backend URL (AI → backend 콜백)
BACKEND_URL=

# OpenAI
OPENAI_API_KEY=
