{
  "annotations": { "list": [] },
  "description": "RDS 인프라 지표(CloudWatch) — node-exporter/cAdvisor는 EC2 인스턴스만 감시해서 관리형 RDS는 잡히지 않는다. 이 대시보드는 CloudWatch 데이터소스로 RDS 네이티브 지표를 직접 조회한다. 모니터링 인스턴스 IAM Role에 CloudWatch 조회 권한(cloudwatch:GetMetricData·ListMetrics·GetMetricStatistics, tag:GetResources, ec2:DescribeTags/DescribeInstances/DescribeRegions)이 없으면 패널이 전부 에러/No data로 뜬다 — deploy/README.md 참고.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "panels": [],
      "title": "RDS 인프라 지표",
      "type": "row"
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU Utilization",
      "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 60 },
              { "color": "red", "value": 80 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
          "region": "$region",
          "namespace": "AWS/RDS",
          "metricName": "CPUUtilization",
          "statistic": "Average",
          "dimensions": { "DBInstanceIdentifier": "$dbinstance" }
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Database Connections",
      "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
