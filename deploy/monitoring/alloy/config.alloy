// Grafana Alloy 설정 — Docker 데몬의 모든 컨테이너 stdout을 수집해 Loki로 push.
// backend(Spring)·report·chatbot(FastAPI)·redis·kafka 로그가 한 번에 딸려 들어온다.
// docker.sock을 read-only로 마운트해 컨테이너 목록·로그 스트림을 읽는다.

logging {
  level  = "warn"
  format = "logfmt"
}

// 살아있는 컨테이너를 발견(30초 주기).
discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "30s"
}

// 라벨 정리: Loki 라벨을 저(低)카디널리티로만 유지한다.
//  - service = 컨테이너 이름(brbs-backend 등). backend 트레이스의 OTLP service.name(brbs-backend)과 일치시켜
//    Tempo↔Loki 상관(tracesToLogs)이 맞물리게 한다.
//  - traceId 같은 고(高)카디널리티 값은 절대 라벨로 승격하지 않는다(로그 본문에 남겨 Grafana derivedField로 추출).
discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "service"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.relabel.containers.output
  relabel_rules = discovery.relabel.containers.rules
  labels        = { job = "docker" }
  forward_to    = [loki.process.parse.receiver]
}

// dev·prod의 Spring 로그는 구조화 JSON(logstash) → level만 라벨로 승격해 필터 편의를 준다.
// JSON이 아닌 라인(redis·kafka 등 평문)은 stage.json이 조용히 통과시킨다.
loki.process "parse" {
  forward_to = [loki.write.default.receiver]

  // 7일(=Loki 보관/거부 기준 reject_old_samples_max_age)을 넘은 로그는 에이전트에서 드롭한다.
  // 오래 떠 있던 컨테이너(chatbot·report 등)의 docker json-file 백로그가 Alloy 재시작 시 재생되면
  // Loki가 "entry too old" 400으로 무더기 거부해 로그가 폭탄이 된다 — 어차피 못 담을 오래된 로그를
  // Loki로 보내기 전에 여기서 버려 그 폭탄을 없앤다.
  stage.drop {
    older_than          = "168h"
    drop_counter_reason = "too_old"
  }

  stage.json {
    expressions = {
      level = "level",
    }
  }
  stage.labels {
    values = { level = "" }
  }
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
