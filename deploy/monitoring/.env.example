# 모니터링 인스턴스(brbs-monitoring) 배포용 환경변수 키 목록. 같은 디렉터리의 docker-compose.yml이 읽는 키만 남겼다.
# 실제 값은 Secrets Manager infra/monitoring-dev에 있고, 배포(deploy-dev.yml의 deploy-monitoring)가 sync-env.sh로
# 서버의 ~/monitoring/.env.dev를 매번 새로 쓴다(#348). 비밀값이 아닌 GRAFANA_ADMIN_USER·GRAFANA_ROOT_URL은
# compose 기본값을 쓰므로 시크릿에 넣지 않았다. 바꿔야 하면 시크릿에 키를 추가하면 된다.
#
# dev 앱(backend·report·chatbot)은 soma-k8s 클러스터로 옮겨 더 이상 이 파일을 쓰지 않는다. 앱 환경변수는
# K8s-manifests 레포 envs/dev/*.values.yaml의 config(일반 값)와 Secrets Manager app/backend-dev 등(시크릿)에서
# 관리한다 — deploy/README.md "설정 바꾸기" 참고.

# 관측성 (Prometheus + Grafana + Loki + Tempo, #88) — 별도 모니터링 인스턴스(brbs-monitoring, #214)에서
# 같은 디렉터리의 docker-compose.yml로 기동. 외부 미노출(127.0.0.1) + SSM 포워드 접근.
# Grafana 초기 관리자 계정(접속 후 비밀번호 변경 권장). GRAFANA_ADMIN_PASSWORD 미설정 시 compose 기동 실패.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# Grafana 루트 URL — SSM 포워드로 접근하면 localhost, 리버스 프록시 뒤면 실제 외부 URL
GRAFANA_ROOT_URL=http://localhost:3000
# 모니터링 알림 Discord 웹훅(시크릿) — severity 라우팅: critical→#alert-critical, warning→#alert-warning.
# 채널마다 웹훅 1개씩 생성해 넣는다. 미설정 시 grafana 기동 실패(의도된 가드)
ALERT_WEBHOOK_URL_CRITICAL=
ALERT_WEBHOOK_URL_WARNING=
