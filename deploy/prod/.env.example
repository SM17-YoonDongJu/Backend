# prod EC2 배포용 환경변수 예시. 실제 값은 서버의 .env.prod(시크릿, chmod 600)에 두고 커밋하지 않는다.
# 이 파일은 "필요한 키 목록" 문서 역할이다. (backend + report + chatbot 공용)

# ECR
ECR_REGISTRY=
BACKEND_TAG=prod
REPORT_TAG=prod
CHATBOT_TAG=prod

# 공통 (backend는 ENV, report/chatbot은 ENVIRONMENT 사용)
ENV=prod
ENVIRONMENT=prod
LOG_LEVEL=INFO
AWS_REGION=ap-northeast-2
# 관측성 식별자(선택, 비우면 hostname)
INSTANCE_ID=

# RDS (Backend) — 운영 DB명은 brbs_prod
DB_HOST=
DB_PORT=5432
DB_NAME=brbs_prod
DB_USER=
DB_PASSWORD=

# RDS (report/chatbot — RAG 검색·저장). ⚠️ backend와 같은 DB(brbs_prod) 공유 → URL 끝 DB명 일치 필수
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/brbs_prod
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
# prod TLS 시에만 (RDS CA 번들 경로)
RDS_CA_PATH=

# Redis (컨테이너: REDIS_HOST=redis) — chatbot 필수
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# SQS (OCR 트리거) — 관리형 AWS SQS. 자격증명은 인스턴스 IAM Role 위임(AWS_REGION 위 참조).
# backend 발행 큐 이름 — backend는 이 이름에서 URL을 런타임 해석하므로 URL env는 불필요.
# 이 큐는 ocr-worker(별도 배포, 이 레포 밖)가 직접 소비한다 — report-worker는 이 큐를 보지 않는다.
SQS_OCR_QUEUE_NAME=brbs-ocr-job-queue-prod
# report-worker가 소비하는 큐 URL. ocr-worker가 OCR을 마치고 이 큐로 결과를 넘기면 report-worker가 받는다
# (Backend → ocr-worker → report-worker 2홉). ocr-worker 배포의 SQS_REPORT_JOB_QUEUE_URL과 같은 큐를 가리켜야 한다.
SQS_REPORT_JOB_QUEUE_URL=

# JWT
JWT_SECRET=

# PII 컬럼 암호화(user_claims·user_insurances) — 운영은 KMS 봉투암호화 경로만 허용(PII_ENC_KEY·PII_HMAC_KEY는
# 둘 다 주입 금지, 주입하면 PiiCryptoProdGuard가 기동을 막는다). PII 전용 신규 KMS CMK 키 ID/ARN — RDS 볼륨 키·
# APPLE_TOKEN_ENC_KEY와 공유 금지. 미설정 시 앱이 기동되지 않는다(fail-fast). PII·PII_HMAC 두 purpose가
# 이 CMK를 공유한다(encryption_keys에 purpose별로 다른 wrapped DEK 저장).
PII_KMS_KEY_ID=

# S3 (자격증명은 IAM Role 자동 탐색 — 키 불필요)
S3_BUCKET=

# OAuth Kakao
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# OAuth Naver
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 로그인 동작(쿠키 인증) — prod: HTTPS + 프론트/백 same-site(brbosang.com ↔ api.brbosang.com)
# OAUTH_BASE_URL: 토큰 교환 redirect_uri의 {baseUrl} = 백엔드 API 도메인
OAUTH_BASE_URL=https://api.brbosang.com
# OAUTH_ALLOWED_REDIRECT_ORIGINS: 프론트가 콜백에 넘긴 redirect_uri를 허용할 오리진 = 프론트 도메인(쉼표 구분)
OAUTH_ALLOWED_REDIRECT_ORIGINS=https://brbosang.com,https://www.brbosang.com
# CORS_ALLOWED_ORIGIN_PATTERNS: ⚠️ 프론트 도메인(API 도메인 아님). 쿠키 인증이라 와일드카드(*) 불가
CORS_ALLOWED_ORIGIN_PATTERNS=https://brbosang.com,https://www.brbosang.com
# 쿠키: prod는 HTTPS + same-site(서브도메인)라 SameSite=Lax로 충분(None 불필요), Secure 필수
COOKIE_SECURE=true
COOKIE_SAME_SITE=Lax

# actuator 관리 포트(9292로 격리). ALB 헬스체크가 이 포트로 오도록 compose가 9292를 호스트 게시한다.
# ⚠️ 인스턴스 SG에서 ALB SG로부터의 9292 인바운드만 허용(외부 직접 노출 금지)
MANAGEMENT_SERVER_PORT=9292

# AI - LLM (GPU 인스턴스 붙을 때까지 placeholder — 미설정 시 report/chatbot 기동 실패 가능)
AI_SERVICE_URL=
AI_BASE_URL=
AI_API_KEY=not-needed
AI_TIMEOUT_SECONDS=60
LLM_MODEL=gemma3:12b

# AI - Embedding
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# 가드레일 NER (USE_NER=true일 때만 NER_* 필요)
USE_NER=false
NER_MODEL=
NER_SCORE_THRESHOLD=

# Backend URL (AI → backend 콜백)
BACKEND_URL=https://api.brbosang.com
